<Window x:Class="OwkCopy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Owk Copy" Width="460" SizeToContent="Height" ResizeMode="CanMinimize"
        Icon="owk.ico" WindowStartupLocation="CenterScreen" AllowDrop="True">
    <StackPanel Margin="16,12,16,14">

        <!-- Header -->
        <DockPanel Margin="0,0,0,10">
            <ToggleButton x:Name="OptionsToggle" DockPanel.Dock="Right" Content="Options" Padding="10,3"
                          ToolTip="Conflict handling, threads, default handler"/>
            <Image Source="owk.ico" Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock Text="Owk Copy" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Setup (hidden while a job runs) -->
        <StackPanel x:Name="SetupPanel">
            <Grid>
                <ListBox x:Name="SourceList" Height="78" SelectionMode="Extended" AllowDrop="True"/>
                <TextBlock x:Name="DropHint" Text="Drag files and folders here" Opacity="0.45" IsHitTestVisible="False"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <UniformGrid Rows="1" Margin="0,6,0,0">
                <Button Content="+ Files" Click="AddFiles_Click" HorizontalAlignment="Stretch" Margin="0,0,3,0"/>
                <Button Content="+ Folder" Click="AddFolder_Click" HorizontalAlignment="Stretch" Margin="3,0"/>
                <Button Content="Remove" Click="Remove_Click" HorizontalAlignment="Stretch" Margin="3,0"/>
                <Button Content="Clear" Click="Clear_Click" HorizontalAlignment="Stretch" Margin="3,0,0,0"/>
            </UniformGrid>
            <DockPanel Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Content="…" Click="Browse_Click" Width="40" Margin="6,0,0,0" ToolTip="Browse"/>
                <TextBox x:Name="DestBox" VerticalContentAlignment="Center" ToolTip="Destination folder"/>
            </DockPanel>
            <DockPanel Margin="0,8,0,0">
                <Button x:Name="StartButton" DockPanel.Dock="Right" Content="Start" Click="Start_Click" Width="96"
                        Style="{DynamicResource AccentButtonStyle}"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="CopyRadio" Content="Copy" IsChecked="True" GroupName="Mode" MinWidth="0" Margin="0,0,10,0"/>
                    <RadioButton x:Name="MoveRadio" Content="Move" GroupName="Mode" MinWidth="0"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <!-- Options (collapsed by default) -->
        <Border x:Name="OptionsPanel" Margin="0,10,0,0" Padding="10" CornerRadius="6"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                Visibility="{Binding IsChecked, ElementName=OptionsToggle, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="If file exists" Width="90" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ConflictBox" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Replace if newer" Tag="IfNewer"/>
                        <ComboBoxItem Content="Always replace" Tag="Overwrite"/>
                        <ComboBoxItem Content="Skip" Tag="Skip"/>
                        <ComboBoxItem Content="Keep both (rename)" Tag="Rename"/>
                    </ComboBox>
                </DockPanel>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="Threads" Width="90" VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=ThreadSlider}" Width="22"
                               TextAlignment="Right" VerticalAlignment="Center"/>
                    <Slider x:Name="ThreadSlider" Minimum="1" Maximum="32" IsSnapToTickEnabled="True" TickFrequency="1"
                            VerticalAlignment="Center"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="Exclude" Width="90" VerticalAlignment="Center"/>
                    <TextBox x:Name="ExcludeBox" ToolTip="Names or wildcards separated by ; e.g. node_modules;*.tmp;.git"/>
                </DockPanel>
                <WrapPanel>
                    <CheckBox x:Name="SkipLinksBox" Content="Skip links / junctions" MinWidth="0" Margin="0,0,14,0"/>
                    <CheckBox x:Name="VerifyBox" Content="Verify after copy" MinWidth="0"/>
                </WrapPanel>
                <Separator Margin="0,8"/>
                <CheckBox x:Name="DefaultBox" Content="Default copy handler (Ctrl+V in Explorer)" MinWidth="0"
                          Click="DefaultBox_Click"/>
                <CheckBox x:Name="MenuBox" Content="&quot;Owk Paste here&quot; in right-click menu" MinWidth="0"
                          Click="MenuBox_Click"/>
            </StackPanel>
        </Border>

        <!-- Progress (shown once a job starts) -->
        <StackPanel x:Name="ProgressPanel" Margin="0,4,0,0" Visibility="Collapsed">
            <DockPanel>
                <TextBlock x:Name="PercentText" DockPanel.Dock="Right" FontSize="20" FontWeight="SemiBold" Text="0%"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                <StackPanel>
                    <TextBlock x:Name="PhaseText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="Ready"/>
                    <TextBlock x:Name="SpeedText" Opacity="0.75" Text=" "/>
                </StackPanel>
            </DockPanel>
            <ProgressBar x:Name="Bar" Height="6" Margin="0,8,0,6" Maximum="1000"/>
            <TextBlock x:Name="StatsText" Opacity="0.75" FontSize="12" TextTrimming="CharacterEllipsis" Text=" "/>
            <TextBlock x:Name="CurrentText" Opacity="0.55" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" Text=" "/>
            <DockPanel Margin="0,10,0,0">
                <ToggleButton x:Name="DetailsToggle" DockPanel.Dock="Right" Content="Details" Padding="10,3"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="PauseButton" Content="Pause" Click="Pause_Click" Width="84"/>
                    <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Width="84" Margin="6,0,0,0"/>
                    <Button x:Name="RetryButton" Content="Retry failed" Click="Retry_Click" Margin="6,0,0,0"
                            Visibility="Collapsed"/>
                    <Button x:Name="NewButton" Content="New job" Click="New_Click" Margin="6,0,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <!-- Log -->
        <ListBox x:Name="LogList" Height="170" Margin="0,10,0,0" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 Visibility="{Binding IsChecked, ElementName=DetailsToggle, Converter={StaticResource BoolToVis}}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="Padding" Value="8,1"/>
                    <Setter Property="MinHeight" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
    </StackPanel>
</Window>
